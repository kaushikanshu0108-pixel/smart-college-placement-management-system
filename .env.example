# ==============================================================================
# Smart College Placement Management System - Environment Configuration Template
# Copy this file to .env and replace the values with your local settings.
# ==============================================================================

# Application Server Port
PORT=5000
NODE_ENV=development

# Express Session Encryption Key (Change to a long random secret in production)
SESSION_SECRET=smart_placement_secure_random_session_key_2026

# MySQL Database Connection Credentials
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_root_password_here
DB_NAME=smart_college_placement
DB_CONNECTION_LIMIT=10

# Web3Forms Support Contact Integration
# Get your free access key at: https://web3forms.com
WEB3FORMS_ACCESS_KEY=your_web3forms_access_key_here

# ==============================================================================
# External Company Intelligence & Auto-Enrichment APIs (Optional / Recommended)
# ==============================================================================
# 1. Brandfetch API Key (Free tier: 500 requests/month)
#    Get key at: https://brandfetch.com/developers
#    Provides: Verified logos, brand colors, industries, legal names, descriptions
BRANDFETCH_API_KEY=your_brandfetch_api_key_here

# 2. Finnhub Stock & Company Profile API Key (Free instant token)
#    Get key at: https://finnhub.io
#    Provides: Stock market capitalization, country, sector, official domain
FINNHUB_API_KEY=your_finnhub_api_key_here
